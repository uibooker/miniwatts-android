<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Only used to detect whether the optional Shizuku app is installed. -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>
    <application android:name=".MiniWattsApp" android:label="@string/app_name" android:icon="@drawable/ic_meter" android:theme="@style/AppTheme" android:allowBackup="false" android:dataExtractionRules="@xml/data_extraction_rules" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <service android:name=".RecordingService" android:exported="false" android:foregroundServiceType="specialUse">
            <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-initiated offline battery current, cell power and temperature logging during charging and screen-off; persistent stop control; optional user-enabled floating meter. No network transfer or connected-device protocol." />
        </service>
        <receiver android:name=".MeterWidget" android:exported="false">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_info" />
        </receiver>
        <!-- Required only for the optional Shizuku channel; unused while the user keeps it off.
             INTERACT_ACROSS_USERS_FULL is granted to the ADB shell but not to normal apps, so the
             provider can only be reached by this app itself and by the Shizuku server. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
